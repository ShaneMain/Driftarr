# Driftarr managed crontab — installed by deploy.sh
# Do not edit via `crontab -e`; changes will be overwritten on next deploy.
# To add a job: add a line here, commit, push → deploy installs it automatically.

# ── Config export (pull live API state → git) — daily; commits only on change ──
0 4 * * * /home/$USER/docker-stacks/configs/run-export.sh >> /home/$USER/config-export.log 2>&1

# ── DNS watchdog: probe + auto-recover AdGuard (LAN-critical once router DHCP points here) ──
* * * * * /home/$USER/docker-stacks/dns/dns-watchdog.sh

# ── Off-site backup — nightly (uncomment once configured; see backup/backup-and-recovery.md) ──
#30 3 * * * /home/$USER/docker-stacks/backup/backup.sh >> /home/$USER/backup.log 2>&1
