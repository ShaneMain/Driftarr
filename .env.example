# Timezone
TZ=America/New_York

# Host paths — adjust to match your server
MEDIA_DIR=/data/media
DOCKER_DIR=/opt/docker
DOWNLOADS_DIR=/data/downloads

# VPN (for Gluetun — downloads stack)
# See https://github.com/qdm12/gluetun-wiki for your provider
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# API Keys (populated after first run of each service)
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=

# Seerr/Jellyseerr/Overseerr (optional — for config-sync if you add a seerr module)
SEERR_API_KEY=
