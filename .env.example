# Timezone
TZ=America/New_York

# Host paths — adjust to match your server
MEDIA_DIR=/data/media
DOCKER_DIR=/opt/docker
DOWNLOADS_DIR=/data/downloads

# VPN (for Gluetun — downloads stack)
# See https://github.com/qdm12/gluetun-wiki for your provider
VPN_SERVICE_PROVIDER=mullvad
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=

# Local DNS (AdGuard Home — dns stack)
# This server's LAN IP: binds port 53 and answers *.home names
DNS_SERVER_IP=192.168.1.50

# Dashboard (Homepage landing page — dashboard stack)
# LAN IP or DNS name of this server; used to build links and poll app APIs
DASHBOARD_HOST=192.168.1.50
# Optional: restrict which host:port origins may serve the page (default *)
#DASHBOARD_ALLOWED_HOSTS=192.168.1.50:3004

# API Keys (populated after first run of each service)
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
BAZARR_API_KEY=

# Seerr/Jellyseerr/Overseerr (optional — for config-sync if you add a seerr module)
SEERR_API_KEY=

# Vaultwarden (optional password-manager stack — vaultwarden/)
# Full external URL you reach it at; needed for WebAuthn/2FA, attachments, push.
VAULTWARDEN_DOMAIN=http://192.168.1.50:8222
VAULTWARDEN_PORT=8222
# Set true for first run to create your account, then set back to false + redeploy.
VAULTWARDEN_SIGNUPS_ALLOWED=false
# Optional: enables the /admin panel. Generate with `docker run --rm vaultwarden/server /vaultwarden hash`
VAULTWARDEN_ADMIN_TOKEN=

# Off-site backup (optional — backup/backup.sh; see backup/backup-and-recovery.md)
# The commented cron entry in ./crontab is the real on/off switch; these values
# just configure the job once you enable it.
# rclone remote to upload to (set up a `crypt` remote first).
RCLONE_REMOTE=crypt:backups
# Docker named volumes to snapshot, space-separated. Pre-wired for the vaultwarden stack.
BACKUP_VOLUMES=vaultwarden_data
# Database dumps as "container:database", space-separated. e.g. "bookstack-db:bookstack"
BACKUP_DB_DUMPS=
# Extra gitignored secret files under your stacks dir, space-separated.
BACKUP_EXTRA_FILES=
