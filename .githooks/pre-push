#!/usr/bin/env bash
# pre-push — block the push if any pushed commit introduces a literal .env value.
# Enabled by `git config core.hooksPath .githooks` (run setup.sh to set it).
# stdin: <local-ref> <local-sha> <remote-ref> <remote-sha> per pushed ref.
GUARD="$(git rev-parse --show-toplevel)/scripts/secret-guard.sh"
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [[ $local_sha =~ ^0+$ ]] && continue             # branch delete — nothing to scan
  if [[ $remote_sha =~ ^0+$ ]]; then
    # New branch: scan every commit reachable from it that no remote ref has yet.
    "$GUARD" range "" "$local_sha" || exit 1
    continue
  fi
  if git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    "$GUARD" range "$remote_sha" "$local_sha" || exit 1
  else
    # Force push / rewritten history: remote_sha may not be an ancestor (or even
    # exist locally) — scan everything not already on some remote ref instead.
    "$GUARD" range "" "$local_sha" || exit 1
  fi
done
exit 0
